    "test": "node scripts/verify-device-credential-contract.mjs && npm run build && node --test dist/test/*.test.js && node --test scripts/test/*.test.mjs",
    "deploy:prod": "npm run deploy:prod:check && node scripts/deploy-prod.mjs --code-only",
    "deploy:prod:check": "node scripts/verify-device-credential-contract.mjs && npm run package:prod && node scripts/deploy-prod.mjs --code-only --check",
    "deploy:prod:upgrade": "npm run deploy:prod",
    "build": "tsc -p tsconfig.json",
    "clean": "rimraf dist",
    "rebuild": "npm run clean && npm run build",
    "prepackage": "npm run rebuild",
    "package:prod": "npm run rebuild && lambda-upload --package-only --skip-bump --no-fix --assume-runtime nodejs24.x"
